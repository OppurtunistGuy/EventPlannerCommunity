generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MenuCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  icon        String?
  description String?
  tab         String     // "coffee", "offers", "food", "bar", "vintage"
  order       Int        @default(0)
  items       MenuItem[]
}

model MenuItem {
  id          String        @id @default(cuid())
  name        String
  description String?
  price       Int
  isVeg       Boolean       @default(true)
  isBestseller Boolean      @default(false)
  isNew       Boolean       @default(false)
  tags        String?       // comma-separated tags
  order       Int           @default(0)
  category    MenuCategory  @relation(fields: [categoryId], references: [id])
  categoryId  String
  orderItems  OrderItem[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  date        String
  time        String
  type        String   // "live", "dj", "themed", "open-mic"
  image       String?
  isFeatured  Boolean  @default(false)
}

model Reservation {
  id        String   @id @default(cuid())
  code      String   @unique // 6-digit code for customer to look up their reservation
  name      String
  phone     String
  email     String?
  date      String
  time      String
  guests    Int
  occasion  String?  // "birthday", "anniversary", "corporate", "casual"
  message   String?
  status    String   @default("confirmed") // "pending", "confirmed", "cancelled", "seated", "completed"
  tableId   String?  // auto-assigned table
  table     Table?   @relation(fields: [tableId], references: [id])
  bill      Bill?
  createdAt DateTime @default(now())
}

model Bill {
  id           String   @id @default(cuid())
  tableId      String
  table        Table    @relation(fields: [tableId], references: [id])
  reservationId String?  @unique
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  subtotal     Int      @default(0)
  gst          Int      @default(0)
  total        Int      @default(0)
  status       String   @default("requested") // "requested", "generated", "settled"
  createdAt    DateTime @default(now())
  settledAt    DateTime?
}

model Table {
  id           String        @id @default(cuid())
  number       Int           @unique
  capacity     Int           @default(4)
  area         String?       // "indoor", "outdoor", "bar", "vip"
  status       String        @default("available") // "available", "occupied", "reserved"
  orders       Order[]
  reservations Reservation[]
  bills        Bill[]
}

model Order {
  id        String      @id @default(cuid())
  tableId   String
  table     Table       @relation(fields: [tableId], references: [id])
  status    String      @default("pending") // "pending", "preparing", "ready", "served", "billed", "cancelled"
  type      String      @default("dine-in") // "dine-in", "waiter"
  notes     String?
  total     Int         @default(0)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id])
  quantity   Int       @default(1)
  price      Int       // price at time of order
  notes      String?   // special instructions
  status     String    @default("pending") // "pending", "preparing", "ready", "served", "cancelled"
}
